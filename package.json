{
  "name": "modern-cli",
  "version": "0.1.0",
  "description": "A modern full-screen terminal app starter built with TypeScript, Node, and Ink.",
  "type": "module",
  "bin": {
    "modern-cli": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/smoke.tsx"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
